{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/domain/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Poppins|Noto Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Poppins, Noto Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchetypeBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|showName|size|style|key|ref|className|style|children)$/]",
        "message": "<ArchetypeBadge> doesn't accept that prop. Declared props: code, showName, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchetypeBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<ArchetypeBadge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|solid|dot|mono|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, solid, dot, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconLeft|iconRight|full|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconLeft, iconRight, full, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:elevation|accent|pad|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: elevation, accent, pad."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:flat|raised|floating)$/]",
        "message": "<Card> elevation must be one of 'flat' | 'raised' | 'floating'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='pad'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> pad must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MechanismTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|family|size|style|key|ref|className|style|children)$/]",
        "message": "<MechanismTag> doesn't accept that prop. Declared props: id, label, family, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MechanismTag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<MechanismTag> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PointsPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|family|size|style|key|ref|className|style|children)$/]",
        "message": "<PointsPill> doesn't accept that prop. Declared props: value, family, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PointsPill'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<PointsPill> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RuleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|title|family|tsr|csr|mechanism|archetype|strictCalls|strictShare|status|style|key|ref|className|style|children)$/]",
        "message": "<RuleCard> doesn't accept that prop. Declared props: code, title, family, tsr, csr, mechanism, archetype, strictCalls, strictShare, status, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RuleCard'] > JSXAttribute[name.name='family'] > Literal[value!=/^(?:repair|risk|priority)$/]",
        "message": "<RuleCard> family must be one of 'repair' | 'risk' | 'priority'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|family|label|threshold|thresholdLabel|max|size|style|key|ref|className|style|children)$/]",
        "message": "<ScoreMeter> doesn't accept that prop. Declared props: value, family, label, threshold, thresholdLabel, max, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreMeter'] > JSXAttribute[name.name='family'] > Literal[value!=/^(?:repair|risk|operational)$/]",
        "message": "<ScoreMeter> family must be one of 'repair' | 'risk' | 'operational'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreMeter'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<ScoreMeter> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|delta|direction|goodWhen|size|hint|style|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: label, value, unit, delta, direction, goodWhen, size, hint, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<Stat> direction must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='goodWhen'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<Stat> goodWhen must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Stat> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
